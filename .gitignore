# ----------------------------------------------------
# 1. Dependencies & Locks
# ----------------------------------------------------
/node_modules
# Yarn 2+ related files
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----------------------------------------------------
# 2. Build Outputs (Frontend & General)
# ----------------------------------------------------
# Next.js
/.next/
/out/
# General build directories
/dist
/build
/coverage
.vercel

# ----------------------------------------------------
# 3. Tauri / Rust Backend Artifacts
# ----------------------------------------------------
# Rust compiler output
/src-tauri/target/

# Generated platform project files
/src-tauri/gen/

# Final installers and bundles
/src-tauri/bundle/

# ----------------------------------------------------
# 4. Environment, Cache, Logs, and OS Files
# ----------------------------------------------------
# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Logs and Keys
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pem

# OS/IDE Files
.DS_Store
Thumbs.db
*.tsbuildinfo
next-env.d.ts
